# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file — it holds live credentials.

# Path to the GA4 service account JSON key file (see README.md, Part 1)
GA4_SERVICE_ACCOUNT_JSON=./credentials/ga4_service_account.json

# Meta Marketing API (see README.md, Part 2)
META_ACCESS_TOKEN=your-system-user-access-token
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
